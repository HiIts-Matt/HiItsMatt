# Copy to .env.deploy — gitignored. Not secrets, just the ids of the resources
# you create once by hand in DEPLOY.md. Credentials are not here: the deploy
# script uses whatever `aws configure` / AWS_PROFILE already gives the CLI.

# Region holding the S3 bucket and the Lambda. Put both in the same one — the
# deploy script passes a single --region to every call.
#
# CloudFront is global and does not care, but the ACM certificate for your
# domain is the exception: it MUST live in us-east-1 no matter what you set
# here, because that is the only region CloudFront reads certificates from.
AWS_REGION=ap-southeast-2

# The bucket holding client/dist. Keep all public access blocked: CloudFront
# reaches it through an Origin Access Control, so it is never a website
# endpoint and never public.
SITE_BUCKET=

# The function running server/src/lambda.ts. Its Function URL must be created
# with invoke mode RESPONSE_STREAM, or the media route breaks on anything
# larger than a few megabytes.
LAMBDA_FUNCTION_NAME=

# The distribution serving both origins, so the site and /api share one origin
# and CORS never enters the picture. Copy the id (E…), not the domain name.
CLOUDFRONT_DISTRIBUTION_ID=

# Optional: a named profile instead of the default credentials.
# AWS_PROFILE=personal
